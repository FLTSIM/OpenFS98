# Run by ofs_install / ofs_revert: -DMODE= -DFS98_DIR= -DSRC= -DOFS_MODULES= -DOFS_ENGLISH=
if(NOT "$ENV{FS98_DIR}" STREQUAL "")
  set(FS98_DIR "$ENV{FS98_DIR}")  # the environment wins over the configured tree
endif()
function(put from to)
  file(COPY_FILE "${from}" "${to}.openfs98" ONLY_IF_DIFFERENT)
  file(RENAME "${to}.openfs98" "${to}")
endfunction()
if(NOT IS_DIRECTORY "${FS98_DIR}/Modules")
  message(FATAL_ERROR "no ${FS98_DIR}/Modules -- set FS98_DIR")
endif()
# the lists arrive space-separated per entry; split each on ';' groups of three
function(each_entry list fn)
  list(LENGTH list n)
  math(EXPR last "${n} - 1")
  foreach(i RANGE 0 ${last} 3)
    list(GET list ${i} name)
    math(EXPR j "${i} + 1")
    math(EXPR k "${i} + 2")
    list(GET list ${j} inst)
    list(GET list ${k} orig)
    cmake_language(CALL ${fn} "${name}" "${inst}" "${orig}")
  endforeach()
endfunction()
function(do_module name inst orig)
  if(MODE STREQUAL "install")
    put("${SRC}/bin/${name}.DLL" "${FS98_DIR}/${inst}")
    message(STATUS "installed ${name} -> ${inst}")
  else()
    put("${SRC}/orig/${orig}" "${FS98_DIR}/${inst}")
    message(STATUS "reverted ${inst}")
  endif()
endfunction()
function(do_english name inst orig)
  if(NOT EXISTS "${FS98_DIR}/${inst}")
    message(FATAL_ERROR "no ${inst} -- set FS98_DIR")
  endif()
  if(MODE STREQUAL "install")
    # the first install keeps the game's own copy beside it
    if(NOT EXISTS "${FS98_DIR}/${inst}.orig")
      file(COPY_FILE "${FS98_DIR}/${inst}" "${FS98_DIR}/${inst}.orig")
    endif()
    put("${SRC}/bin/${name}.DLL" "${FS98_DIR}/${inst}")
  else()
    put("${SRC}/orig/${orig}" "${FS98_DIR}/${inst}")
  endif()
endfunction()
each_entry("${OFS_MODULES}" do_module)
each_entry("${OFS_ENGLISH}" do_english)
