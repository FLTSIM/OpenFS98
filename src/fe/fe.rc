/* Version resource for the reimplemented FE.DLL.
 *
 * The retail module carries Microsoft's: CompanyName "Microsoft Corporation",
 * FileDescription "Flight Simulator 98 Module", version 6.10.418, copyright
 * 1983-1997.  This one deliberately does not copy that.  FLTSIM98.EXE imports
 * no VERSION.DLL and never reads these strings, so nothing functional depends
 * on them -- which makes a rebuilt module claiming to be Microsoft's a lie
 * with no upside.  The numeric version is kept at 6.10.418 to record which
 * retail build this module is a replacement for.
 */
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     6,10,418,0
PRODUCTVERSION  6,10,418,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenFS98"
            VALUE "FileDescription",  "Flight Simulator 98 module (OpenFS98 reimplementation)"
            VALUE "FileVersion",      "6.10.418"
            VALUE "InternalName",     "FE"
            VALUE "OriginalFilename", "FE.DLL"
            VALUE "ProductName",      "OpenFS98"
            VALUE "ProductVersion",   "6.10.418"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
