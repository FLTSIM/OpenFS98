        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenFS98"
            VALUE "FileDescription",  "Flight Simulator 98 module (OpenFS98 reimplementation)"
            VALUE "FileVersion",      "6.10.418"
            VALUE "InternalName",     "G3D"
            VALUE "OriginalFilename", "G3D.DLL"
            VALUE "ProductName",      "OpenFS98"
            VALUE "ProductVersion",   "6.10.418"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
